<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wheel Properties -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.5"/>

  <!-- Wheel positions -->
  <xacro:property name="wheel_x_offset" value="0.13"/>
  <xacro:property name="wheel_y_offset" value="0.17"/>
  <xacro:property name="wheel_z_offset" value="0.0"/>

  <!-- Wheel macro -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="${wheel_mass}"
        radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:cylinder_inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin
        xyz="${x_reflect * wheel_x_offset} ${y_reflect * wheel_y_offset} ${wheel_z_offset}"
        rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- Gazebo wheel properties -->
    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>
  </xacro:macro>

  <!-- Passive rear caster: the 3rd contact point of the differential-drive
       base (2 driven front wheels + this caster). Modelled as a frictionless
       sphere fixed to base_link so it slides freely while the front wheels steer. -->
  <xacro:property name="caster_radius" value="${wheel_radius}"/>
  <xacro:property name="caster_x_offset" value="0.13"/>
  <xacro:property name="caster_mass" value="0.2"/>

  <xacro:macro name="rear_caster">
    <link name="rear_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${caster_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <!-- solid sphere: I = 2/5 m r^2 -->
        <inertia ixx="${0.4 * caster_mass * caster_radius * caster_radius}" ixy="0.0" ixz="0.0"
                 iyy="${0.4 * caster_mass * caster_radius * caster_radius}" iyz="0.0"
                 izz="${0.4 * caster_mass * caster_radius * caster_radius}"/>
      </inertial>
    </link>

    <joint name="rear_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="rear_caster_link"/>
      <origin xyz="${-caster_x_offset} 0 ${wheel_z_offset}" rpy="0 0 0"/>
    </joint>

    <!-- Frictionless in Gazebo so the caster doesn't fight the diff-drive. -->
    <gazebo reference="rear_caster_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>
  </xacro:macro>

  <!-- All wheels macro: 2 driven front wheels + 1 passive rear caster -->
  <xacro:macro name="haller_wheels">
    <xacro:wheel prefix="front_left" x_reflect="1" y_reflect="1"/>
    <xacro:wheel prefix="front_right" x_reflect="1" y_reflect="-1"/>
    <xacro:rear_caster/>
  </xacro:macro>

</robot>

