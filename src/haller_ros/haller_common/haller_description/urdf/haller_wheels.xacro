<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wheel Properties -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.5"/>

  <!-- Wheel positions (drive wheels at base_link origin line) -->
  <xacro:property name="wheel_y_offset" value="0.175"/>  <!-- half of 0.35m separation -->

  <!-- Castor wheel properties -->
  <xacro:property name="castor_radius" value="0.025"/>
  <xacro:property name="castor_mass" value="0.1"/>
  <xacro:property name="castor_x_offset" value="-0.27"/>  <!-- behind drive axle -->

  <!-- Drive wheel macro -->
  <xacro:macro name="drive_wheel" params="prefix y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertial mass="${wheel_mass}"
        radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:cylinder_inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${y_reflect * wheel_y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>
  </xacro:macro>

  <!-- All wheels macro -->
  <xacro:macro name="haller_wheels">
    <!-- Drive wheels (at the front, on the drive axle) -->
    <xacro:drive_wheel prefix="left" y_reflect="1"/>
    <xacro:drive_wheel prefix="right" y_reflect="-1"/>

    <!-- Castor wheel (rear) -->
    <link name="castor_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${castor_radius}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${castor_radius}"/>
        </geometry>
      </collision>
      <xacro:sphere_inertial mass="${castor_mass}" radius="${castor_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:sphere_inertial>
    </link>

    <joint name="castor_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="castor_wheel_link"/>
      <origin xyz="${castor_x_offset} 0 ${-(wheel_radius - castor_radius)}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="castor_wheel_link">
      <material>Gazebo/Grey</material>
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>1.0</maxVel>
    </gazebo>
  </xacro:macro>

</robot>
