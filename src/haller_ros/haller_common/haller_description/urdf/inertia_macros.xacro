<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Inertia Macros -->

  <!-- Box inertia -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia
      ixx="${(1/12) * m * (y*y + z*z)}"
      ixy="0.0"
      ixz="0.0"
      iyy="${(1/12) * m * (x*x + z*z)}"
      iyz="0.0"
      izz="${(1/12) * m * (x*x + y*y)}"/>
  </xacro:macro>

  <!-- Cylinder inertia (oriented along z-axis) -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia
      ixx="${(1/12) * m * (3*r*r + h*h)}"
      ixy="0.0"
      ixz="0.0"
      iyy="${(1/12) * m * (3*r*r + h*h)}"
      iyz="0.0"
      izz="${(1/2) * m * r*r}"/>
  </xacro:macro>

  <!-- Sphere inertia -->
  <xacro:macro name="sphere_inertia" params="m r">
    <inertia
      ixx="${(2/5) * m * r*r}"
      ixy="0.0"
      ixz="0.0"
      iyy="${(2/5) * m * r*r}"
      iyz="0.0"
      izz="${(2/5) * m * r*r}"/>
  </xacro:macro>

  <!-- Box inertial macro -->
  <xacro:macro name="box_inertial" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <xacro:box_inertia m="${mass}" x="${x}" y="${y}" z="${z}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder inertial macro -->
  <xacro:macro name="cylinder_inertial" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <xacro:cylinder_inertia m="${mass}" r="${radius}" h="${length}"/>
    </inertial>
  </xacro:macro>

  <!-- Sphere inertial macro -->
  <xacro:macro name="sphere_inertial" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <xacro:sphere_inertia m="${mass}" r="${radius}"/>
    </inertial>
  </xacro:macro>

</robot>

